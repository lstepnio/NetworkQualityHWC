<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!--
        Held during the Ookla speedtest phase so:
          - WifiManager.WIFI_MODE_FULL_HIGH_PERF keeps the Wi-Fi radio
            out of power-save (otherwise the radio doze cycles steal
            bandwidth and add measurement variance).
          - PARTIAL_WAKE_LOCK keeps the CPU awake even if the screen
            powers off mid-test.
        Released as soon as the phase finishes. ~30s peak hold per cert.
    -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!--
        Both install permissions are declared. The OS grants whichever
        the signing context allows, and AppUpdateInstaller picks the path
        at runtime — same APK works in both modes:

          - Sideloaded (debug build, or release before OEM platform-signs):
            REQUEST_INSTALL_PACKAGES is auto-granted; the system shows the
            "Install update?" dialog and the tech taps Install.
          - Platform-signed (firmware-baked system app): INSTALL_PACKAGES
            is granted by the OS; PackageInstaller runs silently. No
            build-flag flip required to enable this; the installer probes
            the grant via canInstallSilently() on every install attempt.
    -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.INSTALL_PACKAGES"
        tools:ignore="ProtectedPermissions" />

    <uses-feature
        android:name="android.software.leanback"
        android:required="true" />
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <application
        android:name=".FisionApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:banner="@drawable/banner"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.NetworkQualityHWC">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout|smallestScreenSize|uiMode"
            android:theme="@style/Theme.NetworkQualityHWC">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            Receives PackageInstaller status broadcasts after we commit an
            update session. Sees STATUS_PENDING_USER_ACTION (launch confirm
            dialog), STATUS_SUCCESS, and the various STATUS_FAILURE_*
            variants. Not exported — only PackageInstaller itself targets us
            via the PendingIntent we hand to commit().
        -->
        <receiver
            android:name=".update.UpdateInstallReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.hotwire.fisiontv.networkqual.update.INSTALL_RESULT" />
            </intent-filter>
        </receiver>

        <!--
            Re-launches MainActivity after the OS replaces our APK
            (post-self-update). Without this, the install-commit kills
            the old process and the device sits at the launcher until
            the tech manually re-opens us — wiping the value of the
            resume-cert-after-update flow. The broadcast is protected
            (system-sent) and delivered ONLY to the package being
            replaced, so exported="true" is required + safe.
        -->
        <receiver
            android:name=".update.PackageReplacedReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
