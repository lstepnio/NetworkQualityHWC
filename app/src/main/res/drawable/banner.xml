<?xml version="1.0" encoding="utf-8"?>
<!--
    Android TV banner — what shows in the Apps row on the Leanback home.
    Layered: solid FisionNavy background with the official "fisiontv+"
    logo (white-tv variant) centered. The logo file (logo_fision_on_dark)
    is the dark-background variant from the brand kit; pink "fision" +
    white "tv" + gradient "+" reads cleanly on FisionNavy without any
    further treatment.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/fision_navy" />
        </shape>
    </item>
    <item
        android:gravity="center"
        android:left="40dp"
        android:right="40dp"
        android:top="40dp"
        android:bottom="40dp">
        <bitmap
            android:src="@drawable/logo_fision_on_dark"
            android:gravity="center"
            android:filter="true" />
    </item>
</layer-list>
