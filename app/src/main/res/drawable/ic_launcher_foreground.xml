<?xml version="1.0" encoding="utf-8"?>
<!--
    Adaptive icon foreground. Drops the official "fisiontv+" logo into
    the safe zone (the inner ~66dp of the 108dp foreground). Wider than
    tall, so we scale-fit; the launcher's pink background fills around
    it. The white-tv logo variant works on the pink bg without further
    treatment.
-->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:inset="20%">
    <bitmap
        android:src="@drawable/logo_fision_on_dark"
        android:gravity="center"
        android:filter="true" />
</inset>
